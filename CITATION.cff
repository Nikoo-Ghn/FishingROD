    affiliation: "ESRF / UGA"
repository-code: "https://github.com/Nikoo-Ghn/FishingROD"
license: "proprietary"
keywords:
  - GID
  - grazing incidence diffraction
  - MaxiPix
  - reciprocal space
  - synchrotron
  - X-ray diffraction
  - peak detection
  - Gaussian fitting
  - background subtraction
references:
